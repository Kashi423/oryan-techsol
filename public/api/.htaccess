# Oryan Techsol admin/API backend (PHP). Every request that is not a real file goes to the
# front controller; sensitive folders are closed off below.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# Never serve the real config (DB password) or the sample, even if PHP is misconfigured.
<FilesMatch "^config(\.sample)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Referrer-Policy "same-origin"
</IfModule>
