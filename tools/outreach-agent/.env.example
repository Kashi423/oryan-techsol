# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Sending account (a dedicated Gmail with 2-Step Verification ON) ---
# Create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME=Rai at Oryan Techsol
# Name the emails are signed with (must be the person who owns the mailbox)
SIGN_OFF_NAME=Rai
# Where human replies should go (optional). Leave blank to use the Gmail itself.
REPLY_TO=

# --- Claude (writes the emails) ---
ANTHROPIC_API_KEY=
# OUTREACH_MODEL=claude-sonnet-5-5

# --- Google Places API (New) key, with "Places API (New)" enabled ---
GOOGLE_PLACES_API_KEY=

# --- Legal footer: a real postal address is required by CAN-SPAM ---
POSTAL_ADDRESS=1938 West 7th Street, Brooklyn, NY

# --- Guardrails (defaults shown) ---
# DAILY_CAP=15           # a new Gmail should stay at 10-20/day for the first weeks
# MIN_DELAY_SEC=90
# MAX_DELAY_SEC=240
# SEND_WINDOW=9-17       # local hours, Mon-Fri only
# FOLLOWUP_DAYS=4,10     # days after first email; max two follow-ups
# BOUNCE_LIMIT=3         # auto-pause if 3 of the last 25 sends bounced
